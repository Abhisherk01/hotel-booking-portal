# Copy to .env and fill in real values before running the MySQL profile.
# docker compose reads this file automatically; the Spring app reads the
# same variables through the shell (export or set in your IDE run config).

DB_HOST=localhost
DB_PORT=3306
DB_NAME=hotel_booking
DB_USERNAME=hotel_app
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too

# H2 console, development profile only: set true to expose /h2-console
# locally for schema inspection. Leave false everywhere else - a deployed
# environment must never serve the console (it is unauthenticated on the
# H2 dev profile).
H2_CONSOLE_ENABLED=false
